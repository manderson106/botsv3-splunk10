+              min-height: 100px;
+            }
+          </style>
+        </html>
+      <single id="mostactive">
+        <search>
+          <query>index=scoreboard Result=* user!=admin `get_user_info`  | top limit=1 Team</query>
+          <earliest>0</earliest>
+          <latest></latest>
+        </search>
+        <option name="drilldown">none</option>
